{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "baseUrl": ".",
    "paths": { "@/*": ["web/src/*"] },
    "resolveJsonModule": true,
    "useDefineForClassFields": true,
    "isolatedModules": true,
    "types": ["node", "vite/client"]
  },
  "include": ["server", "engine", "shared", "web/src", "tests", "web/vite.config.ts", "vitest.config.ts"]
}
