# Local PostgreSQL. Docker Compose publishes the same credentials.
DATABASE_URL=postgresql://launchforensics:launchforensics@127.0.0.1:5432/launchforensics

# Redis is used for the BullMQ analysis queue.
REDIS_URL=redis://127.0.0.1:6379

# API listen port. The Vite dev server proxies /api to this port.
PORT=4721
WEB_ORIGIN=http://127.0.0.1:4720

# Optional comma-separated Ethereum RPC URLs. Public endpoints are used when empty.
# Historical analysis of older launches needs an archive-capable endpoint.
RPC_URLS=

# Optional. Enables Etherscan source-verification lookups. The app starts without it.
ETHERSCAN_API_KEY=

# Optional OpenAI-compatible endpoint. Used only to rephrase structured findings.
# Calculations never come from the model. Leave blank to use the evidence narrative.
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=gpt-4o-mini
